# Workshop source and authorised supporting files
WORKSHOP_SOURCE_DIR=/path/to/workshop-topics
WORKSHOP_RUNTIME_DIR=/path/to/authorised-cortona-runtime
WORKSHOP_TREE_DIR=/path/to/workshop-trees

# PDF output and working directories
PDF_OUTPUT_DIR=/path/to/pdf-output
PDF_WORK_DIR=/path/to/pdf-work

# Publication settings
PDF_TITLE=INEOS Workshop Manual
PDF_FILENAME=ineos-workshop-manual.pdf
PDF_CONCURRENCY=0
PDF_SAMPLE_SIZE=10
PDF_MERGE_ONLY=0
PDF_ALLOW_PARTIAL=0
PDF_FORCE=0
PDF_SHM_SIZE=16gb
PDF_STATE_CHECKPOINT_INTERVAL=25
PDF_PROGRESS_INTERVAL=10
PDF_HEARTBEAT_SECONDS=60

# Linux file ownership
PUID=1000
PGID=1000
